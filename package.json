{
  "name": "fecofoot-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup-db.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "test:load": "tsx --conditions=react-server scripts/load-test.mts",
    "demo:seed": "tsx scripts/seed-demo.mts",
    "demo:purge": "tsx scripts/purge-demo.mts",
    "demo:transferts": "tsx scripts/seed-demo-transferts.mts",
    "demo:billet": "tsx scripts/seed-demo-billet.mts",
    "demo:badge": "tsx --conditions=react-server scripts/seed-demo-badge.mts",
    "selection:u15": "tsx scripts/u15-bakou.mts",
    "divisions:nationales": "tsx scripts/divisions-nationales.mts",
    "saison:2025-2026": "tsx scripts/saison-2025-2026.mts",
    "photos:import": "tsx --conditions=react-server scripts/import-photos.mts",
    "clubs:import": "tsx --conditions=react-server scripts/import-clubs.mts",
    "logos:officiels": "tsx --conditions=react-server scripts/logos-officiels.mts",
    "sources:import-saison": "tsx --conditions=react-server scripts/import-saison-externe.mts",
    "actualites:import": "tsx --conditions=react-server scripts/import-actualites.mts",
    "start:standalone": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && node .next/standalone/server.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "next": "16.3.7",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
