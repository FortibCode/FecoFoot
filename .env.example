# Connexion PostgreSQL
DATABASE_URL=postgres://fecofoot:motdepasse@localhost:5432/fecofoot

# Secret de signature des sessions (au moins 32 caractères) : openssl rand -base64 32
AUTH_SECRET=

# Premier super administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL=admin@fecofoot.cg
SEED_ADMIN_NAME="Administrateur plateforme"
SEED_ADMIN_PASSWORD=

# URL publique (liens des QR codes et des accords) — obligatoire en production
APP_URL=http://localhost:3000

# Envoi des SMS / e-mails : log (développement, messages consultables dans Administration › Notifications) ou live
NOTIFY_MODE=log

# Double authentification obligatoire pour ces profils (vide = aucun). Défaut : SUPER_ADMIN,FEDERATION_ADMIN,TICKETING
TWO_FACTOR_REQUIRED_ROLES=SUPER_ADMIN,FEDERATION_ADMIN,TICKETING

# Paiements Mobile Money : simulation (aucun débit réel) ou live (API Airtel / MTN, après contrats)
PAYMENT_MODE=simulation
