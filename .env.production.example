# Modèle de configuration de production — copier en .env.production (jamais versionné) et compléter.

# Mot de passe de la base (généré : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Adresse publique HTTPS du site : liens des QR codes, SMS, e-mails ; active HSTS et le passage forcé en HTTPS (ENF-09)
APP_URL=https://www.fecofoot.cg

# Secret de signature des sessions (openssl rand -base64 32)
AUTH_SECRET=

# Premier super administrateur (créé au premier démarrage s'il n'existe pas)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Administrateur plateforme"
SEED_ADMIN_PASSWORD=

# Double authentification obligatoire pour ces profils (EF-AUT-05)
TWO_FACTOR_REQUIRED_ROLES=SUPER_ADMIN,FEDERATION_ADMIN,TICKETING

# Paiements Mobile Money : simulation tant que les contrats Airtel / MTN ne sont pas signés, puis live
PAYMENT_MODE=simulation
# SMS / e-mails : log tant que les fournisseurs ne sont pas choisis, puis live
NOTIFY_MODE=log

# Dossier hôte des sauvegardes (idéalement un disque distinct, copié hors site)
BACKUP_HOST_DIR=/srv/fecofoot/backups

# Conservation du journal d'audit en jours (EF-AUD-02) ; 1825 = 5 ans, 0 = illimitée. Purge nocturne après la sauvegarde.
AUDIT_RETENTION_DAYS=1825
